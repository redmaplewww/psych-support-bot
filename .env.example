# ── LLM ──────────────────────────────────────────────
# 小红书 dots3-note-prev 模型（OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://note3-prev-api.askdiandian.com/v1
OPENAI_MODEL=dots3-note-prev

# ── 数据库 ────────────────────────────────────────────
# 本地开发默认 SQLite，生产环境用 PostgreSQL
DATABASE_URL=sqlite:///./data/psych_support_bot.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/psych_support_bot

# ── Redis（可选，当前未集成）─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse 可观测性 ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://us.cloud.langfuse.com
# 同意后上传本轮用户输入与最终展示回复；上传前执行本地去标识化。
LANGFUSE_CONTENT_ANALYTICS=true
# 生产必须使用稳定随机值；轮换后将无法按旧假名定位并删除历史追踪。
LANGFUSE_PSEUDONYM_KEY=replace_with_a_stable_random_secret
# 注销时异步删除可关联的新旧追踪；有过内容追踪的环境保持 true。
LANGFUSE_DELETE_HISTORY=true
# 流量环境标记：生产保持 production；evals 自动置 eval、pytest 置 test。
# 手动联调脚本建议设 LANGFUSE_ENVIRONMENT=test，避免污染生产 trace。
LANGFUSE_ENVIRONMENT=production

# ── 语音 I/O（与主 LLM 分离的供应商配置）──────────────────────────
# 换供应商 = 改 PROVIDER 行 + 解开该供应商组的注释（其余组保持注释）。
# 多数变量有缺省值（见组内说明），通常只需填 PROVIDER + API_KEY。
#
# ── STT 语音转写（响应速度直接决定对话节奏）────────────────────
# 【minimax · 推荐，~1s】multipart /speech_to_text
#   base_url 缺省 https://api.minimax.cn/v1，model 缺省 asr-1.0
# VOICE_STT_PROVIDER=minimax
# VOICE_STT_API_KEY=your_minimax_key
# VOICE_STT_LANGUAGE=zh
#
# 【mimo · 小米，方言/自动标点，限时免费】chat completions + input_audio base64
#   base_url 缺省 https://api.xiaomimimo.com/v1，model 缺省 mimo-v2.5-asr
# VOICE_STT_PROVIDER=mimo
# VOICE_STT_API_KEY=your_mimo_key
#
# 【openai · OpenAI 兼容网关】multipart /audio/transcriptions
#   base_url/key 缺省回落 OPENAI_*，model 缺省 whisper-1
# VOICE_STT_PROVIDER=openai
# VOICE_STT_API_KEY=your_stt_key
#
# 【dots · 免费，思考型转写 4-6s】chat completions + audio_url base64 内联
#   必须全显式（base_url/model/key 不回落 OPENAI_*）
# VOICE_STT_PROVIDER=dots
# VOICE_STT_BASE_URL=https://note3-prev-api.askdiandian.com/v1
# VOICE_STT_API_KEY=your_dots_key
# VOICE_STT_MODEL=dots3-note-prev
#
# STT 上下文词表（提升领域专名识别：openai 走 whisper prompt 字段、dots 拼进
# 转写指令；minimax/mimo 无此参数不发送）。缺省用内置心理陪伴词表
# （按语种自动选中/英文版）；显式配置即覆盖；置 off 禁用。
# VOICE_STT_PROMPT=正念 着陆练习 心悸
#
# ── TTS 语音合成（未配置时前端降级浏览器朗读）──────────────────
# 【minimax · 双向流式 WS，句级 PCM 直推】
#   model 缺省 speech-2.8-turbo（hd 音质更细），voice 缺省 Warm_Bestie
# VOICE_TTS_PROVIDER=minimax
# VOICE_TTS_API_KEY=your_minimax_key
# VOICE_TTS_WS_URL=wss://api.minimax.cn/ws/v1/t2a_v2_bidi
#
# 【mimo · 小米，wav/pcm16 24kHz，限时免费，支持音色复刻】
#   base_url 缺省 https://api.xiaomimimo.com/v1，model 缺省 mimo-v2.5-tts，
#   voice 缺省 茉莉（候选：冰糖）
# VOICE_TTS_PROVIDER=mimo
# VOICE_TTS_API_KEY=your_mimo_key
#
# 【mimo 音色复刻（MiMo-V2.5-TTS-VoiceClone）】
#   voice 指向存在的 .mp3/.wav 文件即进入复刻模式：参考音频按请求内联
#   （base64 ≤10MB），无持久音色 ID。样本生成见 scripts/make_bestie_samples.py。
#   注意：复刻模型流式为兼容模式（全部合成完才返回），live 朗读首包延迟会
#   明显高于预置音色，介意延迟可只把 /speak 系用复刻音色。
# VOICE_TTS_PROVIDER=mimo
# VOICE_TTS_API_KEY=your_mimo_key
# VOICE_TTS_MODEL=mimo-v2.5-tts-voiceclone
# VOICE_TTS_VOICE=data/voice/bestie_ref.mp3
#
# 【openai · OpenAI 兼容网关 POST /audio/speech】
#   model 缺省 tts-1，voice 缺省 alloy
# VOICE_TTS_PROVIDER=openai
# VOICE_TTS_BASE_URL=https://api.openai.com/v1
# VOICE_TTS_API_KEY=your_tts_key

# ── 应用配置 ──────────────────────────────────────────
ENVIRONMENT=development
APP_DEBUG=true
DEFAULT_CONVERSATION_MODE=support

# ── 账户与认证 ─────────────────────────────────────────
# 商业化部署开启；生产必须固定配置两个独立的 32+ 字符随机密钥。
AUTH_ENABLED=false
JWT_SECRET_KEY=replace_with_a_stable_random_secret
AUTH_IDENTITY_HASH_KEY=replace_with_an_independent_random_secret
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_TOKEN_ISSUER=psych-support-bot
AUTH_TOKEN_AUDIENCE=psych-support-api
# 只有确定长期持有的域名后才配置并启用 Passkey；Origins 用逗号分隔。
# AUTH_PASSKEY_RP_ID=example.com
# AUTH_PASSKEY_ORIGINS=https://auth.example.com,https://app.example.com
# 各平台的 client ID 以逗号分隔；空值表示该供应商登录未启用。
# AUTH_GOOGLE_CLIENT_IDS=google-web-id,google-ios-id,google-android-id
# AUTH_APPLE_CLIENT_IDS=com.example.app,com.example.web
# AUTH_HUAWEI_CLIENT_IDS=huawei-app-id
# 跨域 Web 前端必须逐个列出 HTTPS Origin；同源部署保持空值即可。
# AUTH_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── 上下文切片与画像联动（Context Slicing P3/P4/P5）──────────────────
# P3 切片本体：按话题边界切分对话，本次对话上下文不再跨话题污染。
# ENABLE_CONTEXT_SLICING=false
# P4 切片完成联动：关闭切片时生成摘要（LLM fail-open）+ 主题继承 +
# 画像提取溯源 origin_slice_id。依赖 P3。
# ENABLE_SLICE_BASED_EXTRACTION=false
# P5 画像驱动检索：历史切片摘要按 0.5 时间衰减/0.3 主题匹配/0.2 练习
# 效果加权检索，注入【相关历史】背景块。依赖 P4 产出摘要。
# ENABLE_PROFILE_SLICE_RETRIEVAL=false
