# ── LLM ──────────────────────────────────────────────
# 小红书 dots3-note-prev 模型（OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://note3-prev-api.askdiandian.com/v1
OPENAI_MODEL=dots3-note-prev

# ── 数据库 ────────────────────────────────────────────
# 本地开发默认 SQLite，生产环境用 PostgreSQL
DATABASE_URL=sqlite:///./data/psych_support_bot.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/psych_support_bot

# ── Redis（可选，当前未集成）─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse 可观测性 ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── 应用配置 ──────────────────────────────────────────
ENVIRONMENT=development
APP_DEBUG=true
DEFAULT_CONVERSATION_MODE=support
